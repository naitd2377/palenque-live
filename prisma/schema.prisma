// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL_OVERRIDE")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  messages Message[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  eventDate   DateTime
  price       Float
  currency    String   @default("MXN")
  streamUrl   String?
  streamKey   String?
  rtmpUrl     String?
  streamUrl2  String?
  streamKey2  String?
  rtmpUrl2    String?
  streamUrl3  String?
  streamKey3  String?
  rtmpUrl3    String?
  coverColor  String   @default("#b91c1c")
  status      String   @default("UPCOMING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]
  messages  Message[]

  // Overlays en vivo
  overlayEnabled Boolean  @default(false)
  venueName      String?
  roundLabel     String?
  fightLabel     String?
  winner         String?
  teamRedName    String?
  teamRedScore   Int      @default(0)
  teamGreenName  String?
  teamGreenScore Int      @default(0)
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  amount    Float
  currency  String   @default("MXN")
  status    String   @default("PAID")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Message {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  text      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}
